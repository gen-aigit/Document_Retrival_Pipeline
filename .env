# Weaviate connection (local Docker instance - already populated by the
# ingestion pipeline; this service only reads from it)
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_HOST=localhost
WEAVIATE_GRPC_PORT=50051
# Leave empty for a local instance with anonymous access enabled (default docker-compose setup).
WEAVIATE_API_KEY=

# Embedding model - MUST match the model used at ingestion time, since
# query and document vectors have to come from the same model.
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# Weaviate collections to query, one per category accepted by POST /retrieve
PRODUCT_SPECS_COLLECTION=product_specs
TECHNICAL_SPECS_COLLECTION=technical_specs
REFUND_SPECS_COLLECTION=refund_specs

# API server
API_HOST=0.0.0.0
API_PORT=8000
# Static API key required via the X-API-Key header. Leave empty to disable auth (not recommended outside local dev).
API_KEY=
# Overall per-request budget (seconds): embed + search must complete within this or the caller gets a 504.
REQUEST_TIMEOUT_SECONDS=10
MAX_QUERY_CHARS=1000
RATE_LIMIT_PER_MINUTE=60

# top_k
DEFAULT_TOP_K=5
MAX_TOP_K=20
# Candidate pool retrieved before threshold filtering = top_k * this multiplier,
# so filtering/reranking has real material to work with instead of already-truncated results.
CANDIDATE_K_MULTIPLIER=4

# Hybrid search alpha per collection (0 = pure BM25/keyword, 1 = pure vector).
# product/refund specs contain exact identifiers (product IDs, category names)
# that keyword matching handles more precisely; technical_specs customers
# paraphrase symptoms in their own words, so it leans more vector-heavy.
HYBRID_ALPHA_PRODUCT=0.4
HYBRID_ALPHA_TECHNICAL=0.7
HYBRID_ALPHA_REFUND=0.4

# Minimum hybrid fused score (metadata.score, NOT certainty - certainty is
# only reliable for pure near_vector search) a chunk must clear to be
# returned. Placeholder values - calibrate empirically against a
# representative query set per collection before relying on these in production.
SCORE_THRESHOLD_PRODUCT=0.60
SCORE_THRESHOLD_TECHNICAL=0.60
SCORE_THRESHOLD_REFUND=0.60

# Logging
LOG_FILE_PATH=logs/retrieval_api.log
LOG_LEVEL=INFO
